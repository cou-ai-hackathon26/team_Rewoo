# BanglaShield AI — environment configuration
# Copy to .env and adjust:  cp .env.example .env

# SQLite database file (local/demo). NOTE: the path is resolved relative to
# prisma/schema.prisma, so ../db/custom.db points at <repo>/db/custom.db.
# For serverless deployment (Vercel) use a supported durable database URL
# (e.g. PostgreSQL) — a local SQLite file does not survive serverless
# instances. On Vercel, the vercel-build script provisions the schema
# automatically from whatever DATABASE_URL is set (see README "Deploying
# to Vercel"); when unset, the build falls back to this SQLite path.
DATABASE_URL="file:../db/custom.db"

# HMAC key used to sign analyst session cookies AND guest identity cookies
# (server-side only). IMPORTANT: set a long random value in production:
#   openssl rand -hex 32
SESSION_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
# LLM gateway — OpenRouter (primary when configured) with ZAI sandbox fallback.
# All values are server-side only; never expose keys to the client bundle.
# Docs: https://openrouter.ai/docs
# ---------------------------------------------------------------------------

# OpenRouter key. When empty, the app falls back to the owner-supplied demo
# key embedded in src/lib/llm-gateway.ts so the public Vercel demo works
# without dashboard configuration. Setting this variable ALWAYS overrides the
# embedded key — rotate the demo key and set your own here for production.
OPENROUTER_API_KEY=""

# Exact model ids per purpose (discover at https://openrouter.ai/models).
# Empty = the live-tested V8 defaults (llama-3.3-70b for chat/analysis,
# llama-4-maverick for vision) — see src/lib/chat-models.ts for the curated
# selectable chat catalog.
OPENROUTER_CHAT_MODEL=""
OPENROUTER_ANALYSIS_MODEL=""
OPENROUTER_VISION_MODEL=""

# Ordered fallback candidates (comma-separated exact model ids). Failover is
# single-level per request; a fallback is never counted as the primary model's
# success. Privacy flags apply to every fallback too.
OPENROUTER_FALLBACK_MODELS=""

# Bounded execution (defaults shown).
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=2000

# Cost guards (USD, estimates when the provider does not report exact cost).
AI_DAILY_BUDGET_USD=5
AI_MAX_COST_PER_CASE_USD=0.05

# ASR provider stays an independent adapter (not routed through OpenRouter):
# the runtime's speech-to-text service is used until a qualified Bangla ASR
# is separately evaluated. ASR_PROVIDER/ASR_MODEL are reserved for that.
# V8: in the browser, voice input ALSO runs live Bangla recognition
# (Web Speech API, bn-BD) in parallel — see src/components/shield/pages/check.tsx;
# spoken Bangla text is captured even where the server ASR is unavailable.
ASR_PROVIDER=""
ASR_MODEL=""

# Demo analyst account is created by `bun run db:seed` with the credentials
# documented in README.md ("Demo analyst account"). Change them before any
# real deployment: they are demo-environment credentials, never production ones.
